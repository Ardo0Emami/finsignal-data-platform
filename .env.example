# FinSignal runtime configuration

# Raw writer destination.
# Supported values:
# - local: write raw files under LOCAL_RAW_BASE_PATH
# - s3: write raw files to AWS S3 using FINSIGNAL_RAW_BUCKET
FINSIGNAL_RAW_WRITER=local

# Required only when FINSIGNAL_RAW_WRITER=s3.
FINSIGNAL_RAW_BUCKET=

# Static sample provider input file.
FINSIGNAL_SAMPLE_DATA_PATH=data_samples/market_prices_sample.json

# Local raw landing directory used when FINSIGNAL_RAW_WRITER=local.
FINSIGNAL_LOCAL_RAW_BASE_PATH=data
